{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2019", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "stripInternal": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "outDir": "dist/types/src",
    "rootDir": "src"
  },
  "include": ["src"]
}
